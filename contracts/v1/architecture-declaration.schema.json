{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://briefcase.local/contracts/v1/architecture-declaration.schema.json",
  "title": "Architecture declaration (scan --policy)",
  "description": "The authority artifact retained as .briefcase-input/architecture.json. Domain assignments and report-only rules are the original policy; application, features, workflows and feature_implementations are the declared semantic catalog (ADR-0028, ADR-0029). Every key except authority and revision is optional, so earlier policy files stay valid. Cross-reference rules (unique IDs, existing parents and features, acyclic hierarchy, anchored workflows) are enforced by the importer, not by this schema.",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      }
    },
    "convention_exceptions": {
      "description": "Approved exceptions to observed conventions: module may deviate from depending on target. Consulted before any convergence candidate is reported.",
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/ConventionException"
      }
    },
    "application": {
      "$ref": "#/$defs/Application"
    },
    "features": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/Feature"
      }
    },
    "workflows": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/Workflow"
      }
    },
    "feature_implementations": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/FeatureImplementation"
      }
    }
  },
  "required": [
    "authority",
    "revision"
  ],
  "additionalProperties": false,
  "$defs": {
    "SemanticId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "maxLength": 128
    },
    "Name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "Description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "Aliases": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Name"
      }
    },
    "Reference": {
      "description": "A technical entity named by its exact canonical key. A symbol key may omit its #offset suffix when exactly one symbol matches; several matches are ambiguous and never guessed.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "module",
            "symbol",
            "endpoint",
            "service"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "additionalProperties": false
    },
    "Rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "report-only"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "mode",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "ConventionException": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "module",
        "target",
        "reason"
      ],
      "additionalProperties": false
    },
    "Feature": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SemanticId"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "description": {
          "$ref": "#/$defs/Description"
        },
        "parent": {
          "$ref": "#/$defs/SemanticId"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "$ref": "#/$defs/Aliases"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "Workflow": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SemanticId"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "description": {
          "$ref": "#/$defs/Description"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "$ref": "#/$defs/Aliases"
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/SemanticId"
          }
        },
        "entrypoints": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "participants": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "anchor_pending": {
          "description": "True when the workflow is declared before its entrypoint is known. A workflow needs at least one entrypoint unless this is true.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "features"
      ],
      "additionalProperties": false
    },
    "FeatureImplementation": {
      "type": "object",
      "properties": {
        "feature": {
          "$ref": "#/$defs/SemanticId"
        },
        "subject": {
          "$ref": "#/$defs/Reference"
        }
      },
      "required": [
        "feature",
        "subject"
      ],
      "additionalProperties": false
    },
    "Application": {
      "type": "object",
      "description": "The application this declaration describes (ADR-0029). One source view has at most one declared application; every declared feature belongs to it. Without it, the application is the repository and its description is unknown.",
      "properties": {
        "id": {
          "$ref": "#/$defs/SemanticId"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "description": {
          "$ref": "#/$defs/Description"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
