{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:briefcase:agent-context:2.0",
  "title": "Budgeted agent context routing manifest v2",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "case_id",
    "report_id",
    "view_id",
    "index_id",
    "pinned_views",
    "outcome",
    "outcome_scope",
    "files",
    "not_covered",
    "coverage",
    "sections",
    "fetch_evidence",
    "continue_with",
    "instruction",
    "anchor",
    "fetch_source"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "kind": {
      "const": "agent_context"
    },
    "case_id": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "view_id": {
      "type": "string"
    },
    "index_id": {
      "type": "string"
    },
    "pinned_views": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "outcome_scope": {
      "const": "retained_evidence"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/File"
      }
    },
    "not_covered": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "completeness",
        "delivery"
      ],
      "properties": {
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "delivery": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "object"
    },
    "fetch_evidence": {
      "type": "object"
    },
    "continue_with": {
      "type": [
        "object",
        "null"
      ]
    },
    "instruction": {
      "type": "string"
    },
    "freshness": {
      "type": "object"
    },
    "budget": {
      "type": "object"
    },
    "omissions": {
      "type": "object"
    },
    "anchor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/AnchorFile"
        },
        {
          "$ref": "#/$defs/AnchorTarget"
        }
      ]
    },
    "fetch_source": {
      "type": "object",
      "required": [
        "operation",
        "arguments"
      ],
      "properties": {
        "operation": {
          "const": "explain"
        },
        "arguments": {
          "type": "object",
          "required": [
            "report_id"
          ],
          "properties": {
            "report_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings_status": {
      "enum": [
        "evaluated",
        "not_evaluated"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Completeness": {
      "type": "object",
      "required": [
        "anchors",
        "slice",
        "neighborhood",
        "history",
        "sessions",
        "gap_inventory",
        "verification"
      ],
      "properties": {
        "anchors": {
          "enum": [
            "established",
            "partial",
            "unknown"
          ]
        },
        "slice": {
          "enum": [
            "established",
            "partial",
            "unknown"
          ]
        },
        "neighborhood": {
          "enum": [
            "established",
            "partial"
          ]
        },
        "history": {
          "enum": [
            "established",
            "partial",
            "unknown",
            "not_required"
          ]
        },
        "sessions": {
          "enum": [
            "established",
            "partial",
            "unknown",
            "not_required"
          ]
        },
        "gap_inventory": {
          "enum": [
            "established",
            "partial"
          ]
        },
        "verification": {
          "enum": [
            "unknown",
            "not_required"
          ]
        }
      },
      "additionalProperties": false
    },
    "Range": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "File": {
      "type": "object",
      "required": [
        "path",
        "role",
        "rank",
        "why",
        "ref"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "why": {
          "type": "string",
          "maxLength": 96
        },
        "ref": {
          "type": "string",
          "pattern": "^/slice/[^/]+/[0-9]+$"
        },
        "source_offset": {
          "type": "integer",
          "minimum": 0
        },
        "spans": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "byte_range": {
                "$ref": "#/$defs/Range"
              },
              "line_range": {
                "$ref": "#/$defs/Range"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "AnchorFile": {
      "type": "object",
      "required": [
        "target",
        "status",
        "path",
        "ref"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "status": {
          "const": "resolved"
        },
        "path": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "pattern": "^/slice/[^/]+/[0-9]+$"
        },
        "source_offset": {
          "type": "integer",
          "minimum": 0
        },
        "spans": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "byte_range": {
                "$ref": "#/$defs/Range"
              },
              "line_range": {
                "$ref": "#/$defs/Range"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "AnchorTarget": {
      "type": "object",
      "required": [
        "target",
        "status"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "status": {
          "enum": [
            "resolved",
            "ambiguous",
            "unresolved"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
