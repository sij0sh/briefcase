{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:briefcase:knowledge:1.0",
  "title": "Briefcase knowledge contract v1",
  "$ref": "#/$defs/Bundle",
  "$defs": {
    "Context": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "source"
            },
            "snapshot_id": {
              "type": "string",
              "minLength": 1
            },
            "build_context_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "snapshot_id",
            "build_context_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "runtime"
            },
            "runtime_context_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "runtime_context_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "comparison"
            },
            "snapshot_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "uniqueItems": true,
              "maxItems": 2
            }
          },
          "required": [
            "kind",
            "snapshot_ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "deployment"
            },
            "deployment_context_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "deployment_context_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "session"
            },
            "session_context_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "session_context_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "File": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/File"
          },
          "minItems": 1
        },
        "capture_state": {
          "enum": [
            "complete",
            "partial"
          ]
        }
      },
      "required": [
        "id",
        "repository_id",
        "manifest_digest",
        "files",
        "capture_state"
      ],
      "additionalProperties": false
    },
    "BuildContext": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "settings_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dependency_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "generated_inputs_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "snapshot_id",
        "settings_digest",
        "dependency_digest",
        "generated_inputs_digest"
      ],
      "additionalProperties": false
    },
    "AnalysisConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "producer_name": {
          "type": "string",
          "minLength": 1
        },
        "implementation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "settings_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "producer_name",
        "implementation_digest",
        "settings_digest"
      ],
      "additionalProperties": false
    },
    "RuntimeContext": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "deployed_artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "sampling": {
          "enum": [
            "sampled",
            "complete"
          ]
        },
        "mapping_quality": {
          "enum": [
            "unmapped",
            "service",
            "method"
          ]
        },
        "collector_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true,
          "minItems": 0
        }
      },
      "required": [
        "id",
        "environment",
        "deployed_artifact_digest",
        "start",
        "end",
        "sampling",
        "mapping_quality"
      ],
      "additionalProperties": false
    },
    "EntityVersion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "repository",
            "package",
            "module",
            "file",
            "symbol",
            "endpoint",
            "service",
            "external_system",
            "application",
            "domain",
            "feature",
            "workflow",
            "team",
            "table",
            "column",
            "topic",
            "database",
            "schema",
            "artifact",
            "deployment",
            "source_revision",
            "session"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "canonical_key": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "identity_provider": {
          "type": "string",
          "minLength": 1
        },
        "identity_quality": {
          "enum": [
            "syntax",
            "compiler",
            "exact_mapping",
            "declared",
            "observed",
            "heuristic"
          ]
        },
        "source_evidence_ref_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "language",
        "canonical_key",
        "context",
        "identity_provider",
        "identity_quality"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_kind": {
          "enum": [
            "code",
            "documentation",
            "configuration",
            "runtime",
            "schema",
            "git",
            "transport",
            "session"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "expired",
            "redacted"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "digest",
        "source_kind",
        "availability"
      ],
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "span"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "event"
                },
                "event_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "event_id"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "artifact_id",
        "locator"
      ],
      "additionalProperties": false
    },
    "Guarantee": {
      "type": "object",
      "properties": {
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "syntax_only",
            "exact_supported",
            "sound_overapproximation",
            "observed_sample",
            "unknown",
            "recorded_tools_only"
          ]
        },
        "scope": {
          "type": "string",
          "description": "Explicit subset covered by this guarantee; resolution_complete separately describes exhaustive coverage."
        }
      },
      "required": [
        "predicate",
        "kind"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "attempted": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolution_complete": {
          "type": "boolean"
        },
        "guarantees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Guarantee"
          },
          "minItems": 0
        }
      },
      "required": [
        "attempted",
        "completed",
        "unsupported_count",
        "unresolved_count",
        "resolution_complete",
        "guarantees"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "producer_kind": {
          "enum": [
            "syntax",
            "semantic",
            "documentation",
            "runtime",
            "schema",
            "git",
            "build",
            "deployment",
            "session"
          ]
        },
        "analysis_config_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        }
      },
      "required": [
        "id",
        "producer_kind",
        "analysis_config_id",
        "context",
        "status",
        "coverage"
      ],
      "additionalProperties": false
    },
    "Derivation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pass_name": {
          "type": "string",
          "minLength": 1
        },
        "implementation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_assertion_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "deterministic": {
          "type": "boolean"
        },
        "support_class": {
          "enum": [
            "evidence_only",
            "includes_inference"
          ]
        },
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "input_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "output_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        }
      },
      "required": [
        "id",
        "pass_name",
        "implementation_digest",
        "configuration_digest",
        "input_assertion_ids",
        "deterministic",
        "support_class"
      ],
      "additionalProperties": false
    },
    "InputPacket": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "assertion_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "projection_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "taxonomy_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_evidence_digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "context",
        "assertion_ids",
        "digest"
      ],
      "additionalProperties": false
    },
    "Inference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "model_name": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "output_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider_name": {
          "type": "string",
          "minLength": 1
        },
        "prompt_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "request_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "output_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "taxonomy_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "opaque": {
          "type": "boolean"
        },
        "deterministic": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "packet_id",
        "model_name",
        "model_version",
        "prompt_digest",
        "configuration_digest",
        "output_digest"
      ],
      "additionalProperties": false
    },
    "Authority": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "precedence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "context",
        "precedence"
      ],
      "additionalProperties": false
    },
    "DeclarationRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authority_id",
        "artifact_id",
        "context",
        "revision",
        "effective_from"
      ],
      "additionalProperties": false
    },
    "Resolution": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "resolved",
            "partial",
            "ambiguous",
            "unresolved",
            "unsupported"
          ]
        },
        "method": {
          "enum": [
            "syntax",
            "compiler",
            "observed",
            "heuristic"
          ]
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "method",
        "candidate_ids"
      ],
      "additionalProperties": false
    },
    "Proposition": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "entity"
                },
                "entity_version_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "entity_version_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "literal"
                },
                "value": {
                  "type": [
                    "string",
                    "integer",
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "subject_id",
        "predicate",
        "object"
      ],
      "additionalProperties": false
    },
    "EvidenceAssertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "proposition": {
          "$ref": "#/$defs/Proposition"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "class": {
          "const": "evidence"
        },
        "origin": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "run_id"
          ],
          "additionalProperties": false
        },
        "evidence_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "resolution": {
          "$ref": "#/$defs/Resolution"
        },
        "transformation": {
          "$ref": "#/$defs/Transformation"
        }
      },
      "required": [
        "id",
        "proposition",
        "context",
        "class",
        "origin",
        "evidence_ref_ids"
      ],
      "additionalProperties": false
    },
    "DerivedAssertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "proposition": {
          "$ref": "#/$defs/Proposition"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "class": {
          "const": "derived"
        },
        "origin": {
          "type": "object",
          "properties": {
            "derivation_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "derivation_id"
          ],
          "additionalProperties": false
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "support_class": {
          "enum": [
            "evidence_only",
            "includes_inference"
          ]
        }
      },
      "required": [
        "id",
        "proposition",
        "context",
        "class",
        "origin",
        "supports",
        "support_class"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "proposition": {
          "$ref": "#/$defs/Proposition"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "class": {
          "const": "claim"
        },
        "origin": {
          "type": "object",
          "properties": {
            "inference_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "inference_id"
          ],
          "additionalProperties": false
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "model_score": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "semantics": {
                  "const": "uncalibrated"
                }
              },
              "required": [
                "value",
                "semantics"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "semantics": {
                  "const": "calibrated"
                },
                "calibration_artifact_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "value",
                "semantics",
                "calibration_artifact_id"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
