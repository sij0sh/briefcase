#!/usr/bin/env bash
# Required PR lane: unit tests plus the fast in-process integration suite.
# Tests run with the default parallel harness; no global --test-threads=1.
set -euo pipefail
cd "$(dirname "$0")/.."
state_dir=$(mktemp -d "${TMPDIR:-/tmp}/briefcase-test-state.XXXXXX")
trap 'rm -rf "$state_dir"' EXIT
export XDG_STATE_HOME="$state_dir"
if ! command -v node >/dev/null || [[ ! -f "${BRIEFCASE_TYPESCRIPT_COMPILER:-tools/typescript/node_modules/typescript/lib/typescript.js}" ]]; then
  printf '%s\n' 'Core M6 scans require Node and the pinned compiler. Run: npm ci --ignore-scripts --prefix tools/typescript' >&2
  exit 1
fi
cargo test --locked --lib
cargo test --locked --test core
