#!/usr/bin/env bash
# Required PR lane: one real toolchain invocation per language.
# Compiler concurrency is limited here only, not across the whole suite.
set -euo pipefail
cd "$(dirname "$0")/.."
state_dir=$(mktemp -d "${TMPDIR:-/tmp}/briefcase-test-state.XXXXXX")
trap 'rm -rf "$state_dir"' EXIT
export XDG_STATE_HOME="$state_dir"
if ! command -v node >/dev/null || [[ ! -f "${BRIEFCASE_TYPESCRIPT_COMPILER:-tools/typescript/node_modules/typescript/lib/typescript.js}" ]]; then
  printf '%s\n' 'TS/JS gates require Node and the pinned compiler. Run: npm ci --ignore-scripts --prefix tools/typescript' >&2
  exit 1
fi
python_bin="${BRIEFCASE_PYTHON:-python3}"
"$python_bin" -I -S -B -c 'import ast, sys; assert sys.implementation.name == "cpython" and sys.version_info >= (3, 11), "Python gates require CPython 3.11+"; ast.parse(open("src/architecture/python.py", encoding="utf-8").read())'
go_bin="${BRIEFCASE_GO:-go}"
javac_bin="${BRIEFCASE_JAVAC:-javac}"
if ! command -v "$go_bin" >/dev/null || ! command -v "$javac_bin" >/dev/null || ! command -v gofmt >/dev/null; then
  printf '%s\n' 'Go/Java gates require trusted Go 1.22+ and a full JDK 17+; set BRIEFCASE_GO and BRIEFCASE_JAVAC when needed.' >&2
  exit 1
fi
dotnet_bin="${BRIEFCASE_DOTNET:-dotnet}"
clang_bin="${BRIEFCASE_CLANG:-clang}"
llvm_config_bin="${BRIEFCASE_LLVM_CONFIG:-llvm-config}"
if ! command -v "$dotnet_bin" >/dev/null || ! command -v "$clang_bin" >/dev/null || ! command -v "$llvm_config_bin" >/dev/null; then
  printf '%s\n' 'C#/C/C++ gates require trusted .NET SDK 8+ and matching Clang/LLVM 22+ development tools; set BRIEFCASE_DOTNET, BRIEFCASE_CLANG and BRIEFCASE_LLVM_CONFIG when needed.' >&2
  exit 1
fi
if ! command -v rust-analyzer >/dev/null; then
  printf '%s\n' 'Rust semantic gate requires rust-analyzer on PATH.' >&2
  exit 1
fi
cargo test --locked --test toolchain_smoke -- --test-threads=2
